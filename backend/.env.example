# AuraStudy Environment Configuration Template
# Copy this file to .env and configure your local or remote settings

# Database Connection URL (MySQL / PostgreSQL / SQLite)
DATABASE_URL=mysql+aiomysql://username:password@localhost:3306/new_study_planner

# Groq Cloud API Key for AI Insights & Diagnostics
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Backend Server Configuration
HOST=127.0.0.1
PORT=8001

# CORS Allowed Origins (comma-separated for production website integration)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
